# ─── Dependencies ────────────────────────────────────────────────
node_modules/
**/node_modules/

# ─── Sirlar / env — HECH QACHON commit qilinmasin! ──────────────
# (bot token, JWT secret, Gemini kalitlar, dasturchi paroli shu yerda)
# Barcha .env* fayllar ignore (prod qiymatlar Vercel/Render panelидан beriladi),
# faqat .env.example va .env.production (sir yo'q, faqat backend URL) commit qilinadi.
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example
!frontend/.env.production

# ─── Android keystore (imzolash kaliti — HECH QACHON commit qilinmasin!) ─
*.keystore
*.jks
*.p12
release.properties
key.properties

# ─── Tauri build natijalari ─────────────────────────────────────
frontend/src-tauri/target/

# ─── Capacitor Android project (cap add android tomonidan yaratiladi) ──
# android/ papkasi ignore: `npx cap add android` qayta yaratadi, git'da kerak emas
# frontend/android/

# ─── Capacitor iOS project ──────────────────────────────────────
# frontend/ios/

# ─── Build natijalari ───────────────────────────────────────────
dist/
build/
**/dist/
**/build/

# ─── Yuklangan fayllar (chat media, logolar — repoda saqlanmaydi) ─
backend/uploads/*
!backend/uploads/.gitkeep

# ─── Loglar ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── OS / muharrir ──────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ─── Claude (lokal sozlamalar) ──────────────────────────────────
.claude/
