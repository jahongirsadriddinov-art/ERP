{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QurilishERP",
  "version": "1.2.0",
  "identifier": "uz.erp-firma.qurilisherp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "QurilishERP",
        "width": 1280,
        "height": 800,
        "minWidth": 768,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "Russian"
        ],
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "startMenuFolder": "QurilishERP"
      }
    },
    "resources": [],
    "publisher": "QurilishERP",
    "copyright": "Copyright (c) 2026 QurilishERP",
    "category": "Business",
    "shortDescription": "Qurilish firmalari uchun boshqaruv tizimi",
    "longDescription": "QurilishERP - obyektlar va smeta, materiallar, moliya, xodimlar davomati, GPS nazorati, chat va qo'ng'iroqlar hamda Telegram bot integratsiyasi bitta tizimda.",
    "licenseFile": "installer/LICENSE.txt"
  }
}
