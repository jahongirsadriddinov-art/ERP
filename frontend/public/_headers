# Cloudflare Pages sarlavhalari (vercel.json o'rniga — owner 2026-10-27: domen Cloudflare'ga ko'chirildi)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(self), payment=(), usb=(), interest-cohort=()
  Content-Security-Policy: frame-ancestors 'self' https://web.telegram.org https://*.telegram.org; object-src 'none'; base-uri 'self'

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
/version.json
  Cache-Control: no-cache, no-store, must-revalidate
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Rasm va belgilar — uzoq kesh (Observatory: "cache hit ratio past"). Nomi o'zgarmaydigan fayllar,
# o'zgarsa ham brauzer bir haftada yangilaydi.
/smm/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/avatars/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/ai-avatars/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/favicon.ico
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/favicon-16.png
  Cache-Control: public, max-age=604800
/favicon-32.png
  Cache-Control: public, max-age=604800
/favicon-48.png
  Cache-Control: public, max-age=604800
/favicon-96.png
  Cache-Control: public, max-age=604800
/favicon-192.png
  Cache-Control: public, max-age=604800
/favicon-512.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/og-image.png
  Cache-Control: public, max-age=604800
/qollanma/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
