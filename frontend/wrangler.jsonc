{
  // Cloudflare'da sayt (owner 2026-10-27: domen Cloudflare'ga ko'chirildi, hosting ham shu yerda).
  // Statik fayllar Workers Assets orqali beriladi: public/_headers va public/_redirects o'z-o'zidan
  // qo'llanadi, topilmagan yo'llar esa SPA uchun index.html ga tushadi (/qollanma/ o'z faylini oladi).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qurilish-erp",
  "compatibility_date": "2026-10-23",
  // workers.dev subdomeni kerak emas — sayt faqat o'z domenidan beriladi
  "workers_dev": false,
  // Sayt o'z domenidan beriladi (Cloudflare DNS yozuvlarini o'zi qo'yadi)
  "routes": [
    { "pattern": "erp-firma.uz", "custom_domain": true },
    { "pattern": "www.erp-firma.uz", "custom_domain": true },
    { "pattern": "cf.erp-firma.uz", "custom_domain": true }
  ],
  // Worker loglari (Cloudflare panelidagi sozlama bilan mos bo'lishi uchun) — sayt xatolarini ko'rish
  "observability": {
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true, "persist": true },
    "traces": { "enabled": false, "head_sampling_rate": 1, "persist": true }
  },
  // Fayl ko'prigi: /files/* Render'dan olinadi va Cloudflare chetida keshlanadi (trafikni tejash)
  "main": "worker/index.ts",
  "vars": { "BACKEND_URL": "https://qurilisherp-backend.onrender.com" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
