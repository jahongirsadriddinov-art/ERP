# tgcall-worker sozlamalari. Bu faylni ".env" nomi bilan nusxalang va to'ldiring.
# .env hech qachon git'ga qo'shilmaydi (sirlar faqat shu kompyuterda).

# Backend manzili (Render). Oxirida "/" bo'lmasin.
BACKEND_URL=https://SIZNING-BACKEND.onrender.com

# https://my.telegram.org -> API development tools (AI akkaunt telefoni bilan kiring)
TG_API_ID=
TG_API_HASH=

# Birinchi ishga tushishda AVTOMATIK yaratiladi. Yo'qolsa — Telegram'ga qayta kirish kerak bo'ladi.
TG_SESSION_KEY=

# Ixtiyoriy
# WORKER_ID=tgw-uy-pc
# DATA_DIR=data
# WORKER_PRIVATE_KEY_PATH=data/worker_ed25519.pem
# TG_SESSION_PATH=data/session.enc
# LOG_LEVEL=INFO

# Video avatar (Telegram VIDEO qo'ng'iroqda animatsion yuz): auto | always | off
# AVATAR_VIDEO=auto
# AVATAR_SIZE=640
# AVATAR_FPS=30
# AVATAR_FONT=C:/Windows/Fonts/segoeui.ttf

# Anti-freeze (README "Akkauntlar muzlatilmasin"): akkaunt bo'yicha proksi — O'zbekistondagi rezident/mobil proksi tavsiya
# TG_PROXIES={"<akkaunt id>":"socks5://user:parol@host:1080","platform":"http://user:parol@host:8080"}
# Chegaralar (standart qiymatlar yaxshi) va isitish davri (kun)
# TG_LIMITS={"call":{"hour":12,"day":60}}
# TG_WARMUP_DAYS=7
# Telegram Desktop versiyalari (qurilma izi uchun; " x64" o'zi qo'shiladi)
# TG_APP_VERSIONS=6.1.3,6.2.4,6.3.0
