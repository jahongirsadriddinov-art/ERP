# ─── Backend muhit o'zgaruvchilari (NAMUNA) ──────────────────────
# Bu faylni nusxalab `.env` yarating va haqiqiy qiymatlarni qo'ying.
# Productionда (Render/Railway) bu qiymatlar hosting panelидан beriladi.

# Server porti (Render/Railway o'zi beradi — lokalda 5000)
PORT=5000

# MongoDB ulanish satri
# Lokal:      mongodb://127.0.0.1:27017/erp_firma
# Production: MongoDB Atlas connection string (mongodb+srv://...)
MONGODB_URI=mongodb://127.0.0.1:27017/erp_firma

# Telegram bot tokeni (@BotFather dan)
TELEGRAM_BOT_TOKEN=

# Telegram Webhook (production uchun tavsiya etiladi — 409 Conflict xatosini hal qiladi)
# Lokal devda bo'sh qoldiring → polling rejimi ishlatiladi
# Render'da: https://qurilisherp-backend.onrender.com
# O'rnatgach, webhook avtomatik ro'yxatdan o'tadi (setWebHook chaqiriladi)
TELEGRAM_WEBHOOK_URL=

# JWT imzo kaliti — productionда UZUN, TASODIFIY qiymat qo'ying
JWT_SECRET=change_this_to_a_long_random_string

# Google Gemini API kaliti (smeta tahlili uchun)
GEMINI_API_KEY=
GEMINI_API_KEYS=

# Frontend URL (bot deep-link qaytish tugmasi uchun; productionда https bo'lsin)
# Lokal:      http://localhost:5173
# Production: https://erp-firma.uz
SITE_URL=http://localhost:5173

# Bot username (deep-link uchun; @ siz)
BOT_USERNAME=qurilish_erp_bot

# Backend'ning O'ZINING ochiq manzili (SITE_URL emas — u frontend manzili!).
# Bot orqali yuborilgan rasm/video/fayl/ovoz /uploads orqali shu manzildan
# xizmat qilinadi, shuning uchun Telegram uni haqiqiy URL sifatida yuklay olishi kerak.
# Lokal:      http://localhost:5000
# Production: https://qurilisherp-backend.onrender.com
BACKEND_URL=http://localhost:5000

# Dasturchi (super-admin) kirishi
DEVELOPER_PHONE=+998900960890
DEVELOPER_PASSWORD=1212

# Xodimlarning GPS koordinatasi qancha tez-tez (millisekund) yuborilishi —
# ixtiyoriy, bo'sh qoldirilsa 60000 (1 daqiqa) ishlatiladi. Frontend buni
# GET /api/gps/config orqali oladi, deploy qilmasdan o'zgartirish mumkin.
GPS_INTERVAL_MS=60000

# Dasturchi Telegram chat ID — yangi obuna so'rovlari shu ID'ga yuboriladi.
# Botga /start yuboring va @userinfobot yordamida o'z chat ID'ingizni toping.
DEVELOPER_CHAT_ID=

# Gemini API kaliti (smeta parserning eski AI-yordamchi zaxira yo'li uchun,
# hozirgi oqimda ishlatilmaydi — deterministik parser AI-siz ishlaydi)
# Bir nechta kalit vergul bilan: GEMINI_API_KEYS=key1,key2
# Bitta kalit: GEMINI_API_KEY=key1

# Groq API kaliti (AI Yordamchi — console.groq.com dan bepul oling)
GROQ_API_KEY=
# Ixtiyoriy: model nomi (standart: openai/gpt-oss-120b)
GROQ_MODEL=

# ─── Eskiz.uz SMS OTP (login) ─────────────────────────────────────
# my.eskiz.uz da ro'yxatdan o'ting: Kirish uchun email + shu yerda
# o'rnatgan SMS-servis paroli (akkount parolingiz EMAS).
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# SMS jo'natuvchi nik/raqam (my.eskiz.uz > Nicknames). Standart test/umumiy
# nik odatda 4546 — o'zingizniki bo'lsa shuni yozing.
ESKIZ_FROM=4546
# true bo'lsa — Eskiz TEST akkount talab qiladigan qat'iy matnlardan biri
# yuboriladi (haqiqiy OTP matni EMAS, chunki test akkount boshqa matnni rad
# etadi). Production akkountga o'tganda: false.
ESKIZ_TEST_MODE=true

# ─── Web Push (VAPID) ─────────────────────────────────────────────
# Generatsiya: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com

# ─── Cloudinary (chat media uploads) ─────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email / SMTP (ixtiyoriy — email bildirishnomalari uchun) ─────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="QurilishERP <noreply@yourdomain.com>"

# ─── Yangi versiya e'loni (ixtiyoriy) ──────────────────────────────
# POST /api/deploy/broadcast-update shu kalitni X-Deploy-Secret header'da
# talab qiladi — yangi APK/exe chiqqanda CI (yoki qo'lda) shu yo'lni
# chaqirib, dasturchidan tashqari BARCHA foydalanuvchilarga Telegram orqali
# yuklab olish havolasini yuboradi. Bo'sh qoldirilsa — yo'l butunlay
# ishlamaydi (401), tasodifiy tashqi chaqiruvlardan himoyalangan.
DEPLOY_BROADCAST_SECRET=
